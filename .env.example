# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает (.gitignore).
# Ключ авторизации GigaChat API: https://developers.sber.ru/studio → проект GigaChat API → «Ключ авторизации»
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_TEXT_MODEL=GigaChat-2-Max
GIGACHAT_VISION_MODEL=GigaChat-2-Max
# 0 — показывать окно Chrome при парсинге (как в уроке), 1 — фоновый режим
SELENIUM_HEADLESS=1
